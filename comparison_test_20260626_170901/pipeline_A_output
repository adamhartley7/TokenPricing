export enum SessionStatus {
  IDLE = 'IDLE',
  PLANNING = 'PLANNING',
  ACTING = 'ACTING',
  OBSERVING = 'OBSERVING',
  REFLECTING = 'REFLECTING',
  PAUSED = 'PAUSED',
  COMPLETED = 'COMPLETED',
  ERROR = 'ERROR',
  ABORTED = 'ABORTED',
}

export enum OperationType {
  READ = 'read',
  WRITE = 'write',
  DELETE = 'delete',
  EDIT = 'edit',
  SHELL = 'shell',
  SEARCH = 'search',
}

export interface IAllowlistEntry {
  path: string;
  readOnly: boolean;
}

export interface IOperationPreview {
  description: string;
  filesAffected: string[];
  diff?: string;
  canUndo?: boolean;
}

export interface IToolCall {
  tool: string;
  params: Record<string, any>;
  id: string;
  reasoning?: string;
}

export interface IToolResult {
  success: boolean;
  output: string;
  error?: string;
  data?: any;
}

export interface IStep {
  id: string;
  type: OperationType;
  status: 'pending' | 'confirmed' | 'running' | 'completed' | 'failed';
  toolCall: IToolCall;
  result?: IToolResult;
  startedAt?: number;
  finishedAt?: number;
  cost?: number;
}

export interface IPlannedStep extends IStep {
  isDestructive: boolean;
  preview?: IOperationPreview;
}

export interface ITranscriptEntry {
  timestamp: number;
  type: 'system' | 'user' | 'agent' | 'tool_input' | 'tool_output' | 'cost' | 'confirmation_request' | 'confirmation_response';
  message: string;
  data?: any;
}

export interface IConfirmationRequest {
  id: string;
  sessionId: string;
  stepId: string;
  operation: IOperationPreview;
  timeoutMs?: number;
}

export interface IConfirmationResponse {
  approved: boolean;
  comment?: string;
}

export interface ISessionState {
  id: string;
  status: SessionStatus;
  task: string;
  steps: IStep[];
  plannedSteps: IPlannedStep[];
  transcript: ITranscriptEntry[];
  totalCost: number;
  budgetLimit: number;
  maxSteps: number;
  currentStep: number;
  allowlist: IAllowlistEntry[];
  createdAt: number;
}
