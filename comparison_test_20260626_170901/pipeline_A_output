import { IAllowlistEntry, IOperationPreview, OperationType } from '../../shared/types';
import { coworkConfig } from '../../config/cowork.config';

export class FileSandbox {
  private allowlist: IAllowlistEntry[] = [];
  private stagingBase: string = coworkConfig.stagingDir;

  constructor(allowlist?: IAllowlistEntry[]) {
    if (allowlist) this.allowlist = allowlist.map(entry => ({
      ...entry,
      path: path.resolve(entry.path),
    }));
    else this.allowlist = [...coworkConfig.defaultAllowlist];
  }

  addAllowedDir(entry: IAllowlistEntry) {
    this.allowlist.push({ ...entry, path: path.resolve(entry.path) });
  }

  removeAllowedDir(dirPath: string) {
    this.allowlist = this.allowlist.filter(e => e.path !== dirPath);
  }

  /**
   * Validates a user-provided path (relative or absolute) against the allowlist.
   * Throws if path is outside allowed scope or attempts traversal.
   */
  async resolveAndValidate(userPath: string): Promise<string> {
    // Resolve to absolute, relative to cwd if relative
    const resolved = path.resolve(userPath);

    // Basic traversal check: after resolution, ensure no '..' segments remain
    // that could escape the resolved base. Path.resolve already normalizes, so
    // we just check if the resolved path starts with any allowed directory.
    const allowed = this.allowlist.some(entry => {
      const normalizedEntry = entry.path.endsWith(path.sep) ? entry.path : entry.path + path.sep;
      return resolved.startsWith(normalizedEntry);
    });

    if (!allowed) {
      throw new Error(`Access denied: path "${userPath}" (resolved: "${resolved}") is outside allowed directories.`);
    }

    // Check if file exists? Not needed for validation but may be required later.
    return resolved;
  }

