# Local-only, never-published personal files.
# These are read at runtime by index.html (optional fetch) and written by sync-usage.ps1.
# They may contain personal usage figures, hardware inventory, role/location, etc.,
# so they are git-ignored to keep the published page generic and free of personal data.
usage.json
profile.local.json

# Any local-only JS overrides (personal config dropped in beside the page).
*.local.js

# GLM/Z.ai API key cached locally by glm.ps1 — a secret, never commit it.
.glm-key

# DeepSeek API key cached locally by deepseek.ps1 — a secret, never commit it.
.deepseek-key

# Personal: Anthropic data export + the importer's output + any local vector store.
*.zip
_memory_import/
.vectorstore/
qdrant_storage/

# The example/schema file is committed on purpose (generic placeholders only) — do NOT ignore it.
!profile.local.example.json

# --- 7CE's app -----------------------------------------------------------------
# Secrets: real keys live only in the gateway .env (or the repo-root key files above).
7ces/**/.env
.anthropic-key
# Python virtualenv + bytecode.
7ces/**/.venv/
**/__pycache__/
*.pyc
# Cost ledger (may contain personal usage figures) and any local DB.
7ces/**/*.sqlite3
# Optional bundled DeepSeek tokenizer (large; user downloads it).
7ces/gateway/vendor/
# The example env files ARE committed (placeholders only) — keep them tracked.
!7ces/gateway/.env.example
!7ces/librechat/.env.example
