# 7CE's gateway configuration — copy to 7ces/gateway/.env and fill in.
# NEVER commit .env (it is git-ignored). The gateway can ALSO read the keys from a git-ignored
# .deepseek-key / .anthropic-key file at the repo root (the pattern deepseek.ps1 already uses),
# so if you already cached a DeepSeek key you can leave DEEPSEEK_API_KEY blank here.

# --- Provider API keys (the gateway injects these; LibreChat never sees the real key) ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Spend caps (USD), enforced BEFORE every paid call ---
CAP_PER_REQUEST_USD=0.50
CAP_PER_SESSION_USD=2.00
CAP_PER_DAY_USD=5.00

# Output is always bounded: requests without max_tokens get this, so worst-case output is finite.
DEFAULT_MAX_TOKENS=2048
# Multiply the pre-flight estimate by this so a slightly-low estimate still errs toward refusing.
ESTIMATE_SAFETY_FACTOR=1.10

# --- Server ---
# Bind 0.0.0.0 so LibreChat-in-Docker can reach the gateway via host.docker.internal.
# (See the README security note: caps + Windows Firewall are the backstops. Use 127.0.0.1 if you
#  only call the gateway from the host and not from a container.)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787

# --- Optional: route DeepSeek to a Western host / self-host for sensitive code ---
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
