# 7CE's — values to ADD to LibreChat's OWN .env (in your LibreChat clone, not this repo).
# The REAL API keys live only in the GATEWAY's .env (7ces/gateway/.env). Here they are dummies,
# because the gateway injects the real keys and strips whatever LibreChat sends.

# DeepSeek custom endpoint — referenced by ${DEEPSEEK_API_KEY} in librechat.yaml.
DEEPSEEK_API_KEY=gateway-managed

# Claude via the gateway. ANTHROPIC_REVERSE_PROXY points LibreChat's built-in Anthropic client at
# the gateway (base path only — LibreChat appends /v1/messages).
ANTHROPIC_API_KEY=gateway-managed
ANTHROPIC_REVERSE_PROXY=http://host.docker.internal:8787/anthropic
ANTHROPIC_MODELS=claude-opus-4-8,claude-sonnet-4-6,claude-haiku-4-5
